<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>asistente-api-3f7a9c25-certificacion2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Asistente.Application\Asistente.Application.csproj" />
    <ProjectReference Include="..\Asistente.Infrastructure\Asistente.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="mapa-sistema.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="sistemas.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- La base de conocimiento vive en docs/ (se lee en el repo) y se copia junto a la API para servirla -->
    <Content Include="..\..\docs\arquitectura\*.md" Link="conocimiento\arquitectura\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\instrucciones\*.md" Link="conocimiento\instrucciones\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
