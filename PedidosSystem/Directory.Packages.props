<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Permite la versión flotante del analizador (10.*) -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Permite fijar la versión de dependencias transitivas -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Análisis">
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.*" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <!-- 12.5.0: última versión de MediatR con licencia Apache 2.0 (la 13+ requiere clave de licencia) -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Google.Protobuf" Version="3.31.1" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.76.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <!-- HttpClient tipado (AddHttpClient): llamadas REST al servicio Clientes -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />    <!-- Redis como IDistributedCache (demo de caché) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <!-- Dependencia transitiva de Redis: se fija una versión sin vulnerabilidades (la 9.0.11 que trae está afectada) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- MongoDB: almacenamiento de la auditoría -->
    <PackageVersion Include="MongoDB.Driver" Version="3.11.2" />
    <!-- Cosmos DB: valoraciones de productos (demo) -->
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <!-- Proveedor de EF Core para Cosmos DB (misma versión que el resto de EF Core) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Cosmos" Version="10.0.12" />
    <!-- Blob Storage: imágenes de productos (Azurite en local) -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- El SDK de Cosmos pide referenciar Newtonsoft.Json de forma explícita -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Dapper: consultas de lectura con SQL directo (reportes) -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Solo la interfaz de Swagger: el documento OpenAPI lo genera Microsoft.AspNetCore.OpenApi -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
</Project>
